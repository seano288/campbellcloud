{
  "name": "campbellcloud",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:pairings": "tsc --noEmit -p tools/pairings/tsconfig.json",
    "test": "vitest run",
    "build:pairings": "tsx tools/pairings/build.ts",
    "check:offline": "tsx tools/offline-check.ts",
    "check:baseline": "tsx tools/baseline/browser.ts",
    "baseline:save": "tsx tools/baseline/export-save.ts",
    "build:site": "tsx tools/site-build.ts",
    "check:hunch": "tsx tools/hunch/play.ts",
    "dev:time-flies": "vite --config vite.time-flies.config.ts",
    "dev:hunch": "vite --config vite.hunch.config.ts",
    "dev:cat-nap": "vite --config vite.cat-nap.config.ts"
  },
  "dependencies": {
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@preact/signals": "^2.11.2",
    "preact": "^10.29.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
